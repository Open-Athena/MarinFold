# Ground-truth bundle, generated prediction trees, per-record score CSVs.
# 69 MB of third-party-derived structures — published to the HF bucket by
# publish_gt_bundle.py, which is the source of truth. Rebuildable with
# prepare_gt_structures.py + run_baselines.py.
_scratch/

# US-align source + compiled binary. Rebuild with `bash setup_usalign.sh`;
# the version string it prints is recorded in every scores CSV.
_bin/

.venv/

# The notebook's download cache. explore_predictions.ipynb pulls the published
# ground-truth and prediction tarballs here and unpacks them; that is ~300 MB of
# regenerable PDBs whose source of truth is the public HF bucket. It was
# committed once by accident (2776 files) and stripped from history.
exp174_data/
